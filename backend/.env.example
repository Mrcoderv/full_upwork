# ── Required ──────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/mindfullearning
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET_MIN_32_CHARS

# ── Optional (shown with defaults) ────────────────────
PORT=5010
CLIENT_URL=http://localhost:5173
RATE_LIMIT_MAX_REQUESTS=100000
RATE_LIMIT_WINDOW_MS=900000
# API rate limit per IP per minute (default 1000). Lower if you deploy
# behind per-user IPs; raise if many users share one NAT.
API_RATE_LIMIT_MAX=1000
# MongoDB connection pool size (default 50). Raise toward your peak
# concurrent DB requests; on a healthy mongod ~100-200 suits ~1500 users.
MONGODB_POOL_SIZE=50
MAX_FILE_SIZE=10mb
MAX_CONCURRENT_REQUESTS=50
LOG_LEVEL=info
# GOOGLE_PWD=<app-password-for-nodemailer>

# ── Scrive eSign (signering av betygskataloger, se item #19) ────────────────
# Personal access credentials, hämtas via POST /api/v2/getpersonaltoken med
# användarens e-post+lösenord mot scrive.com (prod) eller api-testbed.scrive.com (testbed).
# Utan dessa är funktionen avstängd och skick-åtgärderna svarar 503.
# SCRIVE_API_BASE_URL=https://api-testbed.scrive.com
# SCRIVE_APITOKEN=
# SCRIVE_APISECRET=
# SCRIVE_ACCESSTOKEN=
# SCRIVE_ACCESSECRET=
# Publik callback-URL dit Scrive skickar dokument-status (POST):
# SCRIVE_CALLBACK_URL=https://<public-host>/api/grade-catalogs/scrive-callback
